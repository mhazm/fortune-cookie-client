# ==========================================
# C++ Build Output & Temporary Directories
# ==========================================
build/
out/
bin/
cmake-build-*/
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln.docstates

# Compiled binaries and libraries
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.obj
*.o
*.exe

# Allow bundled standalone plugin binaries and Ultralight runtime for Companion app distribution
!nismara-companion/resources/*.dll
!nismara-companion/resources/*.so
!nismara-companion/resources/*.dylib
!nismara-companion/src-tauri/resources/*.dll
!nismara-companion/src-tauri/resources/*.so
!nismara-companion/src-tauri/resources/*.dylib
!nismara-companion/src-tauri/resources/runtime/**

# Allow Ultralight build import libraries, runtime DLLs, and core ICU resources
!vendor/ultralight/bin/
!vendor/ultralight/bin/**
!vendor/ultralight/lib/*.lib
!vendor/ultralight/resources/**

# ==========================================
# Node.js & Vite Frontend
# ==========================================
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.vite/
**/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Rust & Tauri Build Artifacts
# ==========================================
target/
**/target/
**/src-tauri/target/
**/src-tauri/gen/schemas/

# Security / Private Keys (Minisign private keys)
*.key
**/nismara.key

# ==========================================
# Runtime Configs, Local Logs & Scratch
# ==========================================
*.dat
*.log
!vendor/ultralight/resources/*.dat
!nismara-companion/src-tauri/resources/runtime/*.dat
imgui.ini
scratch/

# OS specific files
.DS_Store
Thumbs.db
Desktop.ini

# Agent SKILL
.agents/