{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nismara Companion",
  "version": "1.0.1",
  "identifier": "id.web.nismara.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nismara Companion — Official VTC Hub",
        "width": 1120,
        "height": 740,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MkE3NEQzQUNBODI1NkMKUldSc0phaXMwM1FxeFNyaEZRaFJrZFF2UFN0cjJGWnAzS3dBSHJ0MVBORmxZOGk3NkhLK0paWU8K",
      "endpoints": [
        "https://github.com/mhazm/fortune-cookie-client/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/NismaraTracker.dll",
      "../resources/NismaraTracker.dll"
    ]
  }
}
